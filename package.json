{
  "name": "saucedemo-cypress-qa",
  "version": "1.1.3",
  "description": "Automação E2E do SauceDemo com Cypress, Page Objects e relatório Mochawesome",
  "private": true,
  "scripts": {
    "cy:open": "cypress open",
    "test": "cypress run",
    "test:headed": "cypress run --headed",
    "test:chrome": "cypress run --browser chrome",
    "test:firefox": "cypress run --browser firefox",
    "test:edge": "cypress run --browser edge",
    "test:smoke": "cypress run --spec \"cypress/e2e/auth/login.cy.js,cypress/e2e/purchase/purchaseFlow.cy.js\"",
    "lint": "eslint cypress scripts cypress.config.js",
    "lint:fix": "eslint cypress scripts cypress.config.js --fix",
    "format": "prettier --write ."
  },
  "keywords": ["cypress", "qa", "automation", "saucedemo", "mochawesome"],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "cypress": "^13.17.0",
    "cypress-mochawesome-reporter": "^3.8.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-cypress": "^3.6.0",
    "prettier": "^3.3.3"
  }
}
